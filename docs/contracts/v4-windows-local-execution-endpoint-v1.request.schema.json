{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrhz1973/control-plane/docs/contracts/v4-windows-local-execution-endpoint-v1.request.schema.json",
  "title": "v4-windows-local-execution-endpoint-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "runtime_authorization",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-windows-local-execution-endpoint-request-v1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "runtime_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_id",
        "authorization_state",
        "route_id",
        "scope"
      ],
      "properties": {
        "schema_version": {
          "const": "operator-runtime-authorization-v1"
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorization_state": {
          "const": "ACTIVE"
        },
        "route_id": {
          "const": "opencode+qwen_local"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_version",
            "execution_harness",
            "model",
            "profile_id",
            "role",
            "canonical_endpoint",
            "single_generation_guard_required",
            "max_opencode_executions",
            "max_qwen_generation_calls",
            "retry",
            "fallback"
          ],
          "properties": {
            "scope_version": {
              "const": "qwen-execution-scope-v2"
            },
            "execution_harness": {
              "const": "opencode"
            },
            "model": {
              "const": "qwen_local"
            },
            "profile_id": {
              "const": "qwen38-dcfr-iq3-agent-24k"
            },
            "role": {
              "const": "FAST_AGENT"
            },
            "canonical_endpoint": {
              "const": "http://127.0.0.1:8080"
            },
            "single_generation_guard_required": {
              "const": true
            },
            "max_opencode_executions": {
              "const": 1
            },
            "max_qwen_generation_calls": {
              "const": 1
            },
            "retry": {
              "const": 0
            },
            "fallback": {
              "const": 0
            }
          }
        }
      }
    }
  }
}
