{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrhz1973/control-plane/docs/contracts/quota-pool-status-v1.schema.json",
  "title": "quota-pool-status-v1",
  "description": "Minimal complementary dynamic-status contract for shared commercial quota pools referenced by resource-registry-v2 quota_pool_id. One status entry per POOL (never per model/surface). Observation data only; reserve policy and economics are represented only as explicit references/verified payloads. Unknown stays unknown; nothing here authorizes execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "quota_pools"],
  "properties": {
    "schema_version": { "const": "quota-pool-status-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "quota_pools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/poolStatus" }
    }
  },
  "$defs": {
    "poolStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quota_pool_id",
        "state",
        "windows",
        "source",
        "observed_at",
        "updated_at",
        "freshness",
        "reserve_policy_ref",
        "economics"
      ],
      "properties": {
        "quota_pool_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "state": {
          "description": "Known/availability state observed at observed_at. available = observed with remaining > 0; exhausted = observed remaining 0; unknown = insufficient evidence. Never implies current availability.",
          "enum": ["available", "exhausted", "unknown"]
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/windowObservation" }
        },
        "source": {
          "enum": ["dashboard_snapshot", "manual", "provider_api", "internal_ledger"]
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "freshness": {
          "description": "Deterministic staleness classification vs the injectable evaluation clock and the contract max age.",
          "enum": ["fresh", "stale"]
        },
        "reserve_policy_ref": {
          "description": "Reference/identifier of the separately governed reserve policy, or null. Reserve policy is NOT observed data.",
          "type": ["string", "null"]
        },
        "economics": {
          "description": "Provider economics ONLY when actually supplied and explicitly verified by the evidence; otherwise null (unknown).",
          "type": ["object", "null"]
        }
      }
    },
    "windowObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_type", "remaining", "freshness"],
      "properties": {
        "window_type": {
          "enum": ["rolling", "weekly", "monthly", "unknown"]
        },
        "remaining": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "unit": {
              "enum": ["percent", "normalized", "unknown"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "unit": { "const": "percent" } },
                "required": ["unit"]
              },
              "then": {
                "properties": {
                  "value": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            },
            {
              "if": {
                "properties": { "unit": { "const": "normalized" } },
                "required": ["unit"]
              },
              "then": {
                "properties": {
                  "value": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            },
            {
              "if": {
                "properties": { "unit": { "const": "unknown" } },
                "required": ["unit"]
              },
              "then": {
                "properties": { "value": { "type": "null" } }
              }
            }
          ]
        },
        "window_ends_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "reset_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "freshness": { "enum": ["fresh", "stale"] }
      }
    }
  }
}
