{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrhz1973/control-plane/docs/contracts/resource-registry-v2.schema.json",
  "title": "resource-registry-v2",
  "description": "Static resource registry v2 separating MODEL/ROLE -> ACCESS_SURFACE -> QUOTA_POOL, with a backward-compatible `resources` projection of resource-registry-v1 for unmigrated consumers. Static capabilities/relationships only: dynamic quota/usage/reset values are forbidden here and belong to resource-status-v1 observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_metadata",
    "models",
    "access_surfaces",
    "quota_pools",
    "resources"
  ],
  "properties": {
    "schema_version": { "const": "resource-registry-v2" },
    "registry_metadata": { "$ref": "#/$defs/registryMetadata" },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/modelEntry" }
    },
    "access_surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/accessSurfaceEntry" }
    },
    "quota_pools": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/quotaPoolEntry" }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/v1ResourceEntry" }
    }
  },
  "$defs": {
    "registryMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "purpose", "compatibility", "dynamic_data_policy"],
      "properties": {
        "version": { "const": 2 },
        "date": { "type": "string" },
        "purpose": { "type": "string" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resources_projection", "projection_source", "removal_policy"],
          "properties": {
            "resources_projection": { "type": "string" },
            "projection_source": { "type": "string" },
            "removal_policy": { "type": "string" }
          }
        },
        "dynamic_data_policy": { "type": "string" }
      }
    },
    "roleId": {
      "enum": [
        "planner",
        "implementation_harness",
        "implementation_model",
        "routing_arbiter",
        "reviewer",
        "classifier"
      ]
    },
    "capabilityId": {
      "enum": [
        "filesystem",
        "terminal",
        "code_edit",
        "planning",
        "classification",
        "routing_arbitration",
        "code_generation",
        "review",
        "persistent_agent",
        "browser"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "modelSelectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "frozen_list"],
      "properties": {
        "selection": { "enum": ["dynamic", "explicit"] },
        "frozen_list": { "const": false },
        "note": { "type": "string" },
        "reasoning_requirement": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["low", "medium", "high", "extra_high", "provider_default"] }
        },
        "speed_preference": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["fast", "balanced", "quality"] }
        }
      }
    },
    "modelEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "provider",
        "roles",
        "capabilities",
        "default_access_surface",
        "status"
      ],
      "properties": {
        "model_type": {
          "enum": ["remote_api_model", "local_model", "hosted_model", "provider_managed_selection"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleId" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "default_access_surface": { "$ref": "#/$defs/identifier" },
        "model_selection_policy": { "$ref": "#/$defs/modelSelectionPolicy" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "accessSurfaceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_type", "auth", "quota_pool_id", "status"],
      "properties": {
        "surface_type": {
          "enum": [
            "ide_extension",
            "external_cli_worker",
            "local_harness",
            "byok_route",
            "hosted_route",
            "supported_plan_client",
            "none"
          ]
        },
        "representational_only": { "type": "boolean" },
        "host_harness": { "type": ["string", "null"] },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "forbidden"],
          "properties": {
            "allowed": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "forbidden": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "quota_pool_id": { "type": ["string", "null"] },
        "commercial_quota": { "enum": ["none_local_unmetered"] },
        "allowance_ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["unverified", "verified"] },
            "note": { "type": "string" }
          }
        },
        "model_selection_policy": { "$ref": "#/$defs/modelSelectionPolicy" },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_qualified"],
          "properties": {
            "runtime_qualified": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },
        "note": { "type": "string" },
        "status": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "surface_type": { "const": "none" } }, "required": ["surface_type"] },
          "then": {
            "properties": {
              "representational_only": { "const": true },
              "quota_pool_id": { "type": "null" },
              "status": { "const": "forbidden" }
            },
            "required": ["representational_only"]
          }
        },
        {
          "if": {
            "properties": { "surface_type": { "const": "local_harness" } },
            "required": ["surface_type"]
          },
          "then": {
            "properties": {
              "quota_pool_id": { "type": "null" },
              "commercial_quota": { "enum": ["none_local_unmetered"] }
            }
          }
        }
      ]
    },
    "quotaPoolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_type",
        "provider",
        "billing_boundary",
        "quota_source_allowed",
        "dynamic_values",
        "status"
      ],
      "properties": {
        "pool_type": { "enum": ["subscription_included"] },
        "provider": { "type": "string", "minLength": 1 },
        "plan": { "type": "string", "minLength": 1 },
        "shared_by_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "shared_by_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "billing_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["includes", "excludes"],
          "properties": {
            "includes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "excludes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "quota_source_allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dashboard_snapshot", "normalized_collector_future"] }
        },
        "dynamic_values": { "const": "forbidden_in_registry" },
        "note": { "type": "string" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "v1ResourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "execution_location",
        "roles",
        "capabilities",
        "compatible_resources",
        "requires_network"
      ],
      "properties": {
        "resource_type": { "enum": ["harness", "model", "agent"] },
        "execution_location": { "enum": ["local", "cloud", "hybrid", "remote"] },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleId" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "compatible_resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "requires_network": { "type": "boolean" }
      }
    }
  }
}
