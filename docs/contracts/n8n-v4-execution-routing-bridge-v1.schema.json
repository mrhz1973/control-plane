{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrhz1973/control-plane/docs/contracts/n8n-v4-execution-routing-bridge-v1.schema.json",
  "title": "n8n-v4-execution-routing-bridge-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "classification",
    "task_id",
    "packet_id",
    "route_request_id",
    "policy_decision",
    "route_status",
    "execution_route_result",
    "route_id",
    "implementer",
    "model",
    "adapter_registered",
    "adapter_id",
    "dispatch_required",
    "dispatch_prepared",
    "execution_performed",
    "reason_codes"
  ],
  "properties": {
    "schema_version": { "const": "n8n-v4-execution-routing-bridge-result-v1" },
    "ok": { "type": "boolean" },
    "classification": {
      "type": "string",
      "enum": [
        "ROUTING_READY_FOR_DISPATCH",
        "POLICY_GATE_REQUIRED",
        "POLICY_BLOCKED",
        "POLICY_INVALID",
        "CYCLE_RESULT_INVALID",
        "ROUTE_REQUEST_INVALID",
        "NO_ROUTE",
        "ADAPTER_REGISTRY_INVALID",
        "ADAPTER_NOT_REGISTERED",
        "RESOURCE_STATUS_INVALID",
        "RESOURCE_REGISTRY_INVALID"
      ]
    },
    "task_id": { "type": ["string", "null"] },
    "packet_id": { "type": ["string", "null"] },
    "route_request_id": { "type": ["string", "null"] },
    "policy_decision": { "type": ["string", "null"], "enum": [null, "PROCEED", "GATE", "BLOCKED"] },
    "route_status": { "type": ["string", "null"] },
    "execution_route_result": { "type": ["object", "null"] },
    "route_id": { "type": ["string", "null"] },
    "implementer": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "adapter_registered": { "type": "boolean" },
    "adapter_id": { "type": ["string", "null"] },
    "dispatch_required": { "type": "boolean" },
    "dispatch_prepared": { "const": false },
    "execution_performed": { "const": false },
    "reason_codes": { "type": "array", "items": { "type": "string" } }
  }
}
